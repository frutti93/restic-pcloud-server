# Copy this file to .env and fill in your own values, then: docker compose pull && docker compose up -d

# Path to YOUR rclone.conf on the Docker host (the one with the pCloud remote already
# authenticated). Find your remote's name inside it if unsure:
#   grep '^\[' ~/.config/rclone/rclone.conf
RCLONE_CONF_PATH=/home/youruser/.config/rclone/rclone.conf

# Fixed rclone remote:path root. Must match a [remote-name] section in the rclone.conf
# above. Each restic repo gets its own subfolder under this root, named by the client -
# restic points at it via rest:https://user:pass@host/<repo-name>/, e.g. .../nas-archive/
# or .../nas-pictures/. The server only ever writes inside this root; it never lets a
# client pick a different rclone remote.
PCLOUD_REMOTE_ROOT=pcloud:Backups/restic

# Verbose per-request/per-stage debug logging (timing, concurrency, retry detail). Leave
# false for normal operation; flip to true temporarily when actually troubleshooting - it's
# noisy enough to bury the errors you're looking for otherwise.
DEBUG=false

# HTTP Basic Auth credentials for the server. restic's REST backend supports this natively
# via the repository URL (rest:https://user:pass@host/). REQUIRED once this is reachable
# through Traefik from anywhere other than a fully trusted private network - restic's REST
# protocol has no auth of its own, so without this anyone who can reach the hostname below
# can read, write, or delete the whole repository. Pick a long random password.
AUTH_USER=restic
AUTH_PASS=change-me-to-something-long-and-random

# Traefik wiring
REPAIR_HOSTNAME=restic-repair.yourdomain.tld
TRAEFIK_CERTRESOLVER=letsencrypt
# The docker network your Traefik container is already attached to - check with:
#   docker network ls
TRAEFIK_NETWORK=traefik
